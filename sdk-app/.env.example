# GrowthOS SDK Configuration
# Copy to .env and fill in values

# Required: Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-...

# GCO persistence directory (default: ~/.growthos/contexts/)
GCO_DIR=~/.growthos/contexts

# Content root: path to growth-marketplace repo root
# Used to resolve SKILL.md, frameworks, templates at runtime
CONTENT_ROOT=..

# Budget guards (Agentic Constitution Art. VI)
BUDGET_SESSION_LIMIT_USD=2.00
BUDGET_DAILY_LIMIT_USD=10.00
BUDGET_VALIDATION_WARN_USD=500.00

# Model selection overrides (default: opus for orchestrator, sonnet for subagents)
MODEL_ORCHESTRATOR=opus
MODEL_SUBAGENT_DEFAULT=sonnet
MODEL_BATCH=haiku

# Optional: MCP bridge connections
# FIREFLIES_API_KEY=
# NOTION_API_KEY=
# SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
AUDIT_ENABLED=true
